# Copy to .env and fill in.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini-2025-04-14

OPENAI_PRICE_INPUT=0.40
OPENAI_PRICE_CACHED_INPUT=0.10
OPENAI_PRICE_OUTPUT=1.60

# Frontend host port. Container always listens on 80 inside.
FRONTEND_PORT=18782

# WHOIS tuning.
# Per-query timeout in seconds.
WHOIS_TIMEOUT=30
# How many parallel whois queries.
WHOIS_CONCURRENCY=8
# Cache TTL in seconds (in-memory, per backend process).
WHOIS_CACHE_TTL=3600
